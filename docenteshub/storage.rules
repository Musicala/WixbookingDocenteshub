rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        "alekcaballeromusic@gmail.com", "catalina.medina.leal@gmail.com"
      ];
    }
    function ownsFolder(teacherEmail) { return signedIn() && request.auth.token.email == teacherEmail; }
    function validEvidence() {
      return request.resource != null && (
        (request.resource.contentType.matches('image/.*') && request.resource.size <= 8 * 1024 * 1024) ||
        (request.resource.contentType.matches('video/.*') && request.resource.size <= 30 * 1024 * 1024)
      );
    }
    match /academic-evidence/{teacherEmail}/{taskId}/{logId}/{fileName} {
      allow read: if ownsFolder(teacherEmail) || isAdmin();
      allow create, update: if (ownsFolder(teacherEmail) || isAdmin()) && validEvidence();
      allow delete: if ownsFolder(teacherEmail) || isAdmin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
